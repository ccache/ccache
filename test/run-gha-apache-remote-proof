#!/usr/bin/env bash

set -euo pipefail

source_archive="${1:?source archive path is required}"
proof_log="${2:?proof log path is required}"
proof_status="${3:?proof status path is required}"

set +e
docker run --rm --name ccache-ng-gha-apache-proof \
  -v "${source_archive}:/input.tar:ro" \
  -i "${CONTAINER_IMAGE:-alpine:3.22}" sh -lc '
    set -eu
    mkdir -p /src
    tar -xf /input.tar -C /src
    apk add --no-cache bash cmake samurai g++ gcc make python3 curl curl-dev \
      zstd-dev xxhash-dev doctest-dev fmt-dev apr-dev apr-util-dev pcre2-dev \
      openssl-dev >/tmp/apk.log 2>&1 || { tail -n 100 /tmp/apk.log; exit 1; }
    exec bash /src/test/run-gha-apache-container
  ' 2>&1 | tee "${proof_log}"
result=${PIPESTATUS[0]}
set -e
printf '%s\n' "${result}" >"${proof_status}"
